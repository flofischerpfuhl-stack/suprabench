{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "allowJs": true,
    "types": ["vitest/globals"],
    "paths": {
      "~convex/*": ["../../convex/*"]
    }
  },
  "include": ["**/*.ts", "../../convex/**/*.ts"]
}
