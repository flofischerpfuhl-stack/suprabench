{
  "$schema": "https://json.schemastore.org/web-manifest-combined.json",
  "id": "/",
  "name": "SupraBench — AI Model Rankings",
  "short_name": "SupraBench",
  "description": "Community-driven AI model rankings, weighted by benchmark trustworthiness.",
  "lang": "en",
  "dir": "ltr",
  "start_url": "/?source=pwa",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui", "browser"],
  "orientation": "any",
  "background_color": "#030303",
  "theme_color": "#030303",
  "categories": ["productivity", "education", "developer", "utilities"],
  "icons": [
    {
      "src": "/img/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/img/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/img/icon-192-maskable.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/img/icon-512-maskable.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/img/apple-touch-icon.png",
      "sizes": "180x180",
      "type": "image/png",
      "purpose": "any"
    }
  ],
  "shortcuts": [
    {
      "name": "Models",
      "short_name": "Models",
      "description": "Browse the ranked model leaderboard",
      "url": "/?source=pwa#models",
      "icons": [{ "src": "/img/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Benchmarks",
      "short_name": "Benches",
      "description": "Browse benchmarks and their quality scores",
      "url": "/?source=pwa#benches",
      "icons": [{ "src": "/img/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Submit a score",
      "short_name": "Submit",
      "description": "Contribute a new benchmark score",
      "url": "/?source=pwa#submit",
      "icons": [{ "src": "/img/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "About SupraBench",
      "short_name": "About",
      "description": "How the SupraScore is calculated",
      "url": "/?source=pwa#about",
      "icons": [{ "src": "/img/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    }
  ],
  "screenshots": [
    {
      "src": "/img/og-image.png",
      "sizes": "1200x630",
      "type": "image/png",
      "form_factor": "wide",
      "label": "SupraBench — community-weighted AI model leaderboard"
    },
    {
      "src": "/img/og-image.png",
      "sizes": "1200x630",
      "type": "image/png",
      "label": "SupraBench leaderboard preview"
    }
  ],
  "launch_handler": {
    "client_mode": ["focus-existing", "auto"]
  },
  "prefer_related_applications": false,
  "edge_side_panel": {
    "preferred_width": 480
  },
  "handle_links": "preferred"
}
