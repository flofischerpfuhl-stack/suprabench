# Cloudflare Pages custom headers
# Docs: https://developers.cloudflare.com/pages/platform/headers/

# ── HTML: short cache, re-validate on every visit ──
/
  Cache-Control: public, max-age=0, must-revalidate
/*.html
  Cache-Control: public, max-age=0, must-revalidate

# ── Static assets: hashed or rarely changing → long cache ──
/img/*
  Cache-Control: public, max-age=31536000, immutable
/css/*
  Cache-Control: public, max-age=86400
/js/*
  Cache-Control: public, max-age=86400

# ── SEO helpers: short cache ──
/robots.txt
  Cache-Control: public, max-age=3600
/sitemap.xml
  Cache-Control: public, max-age=3600

# ── API documentation pages ──
# Docs are static HTML; cache aggressively at the edge but allow
# Cloudflare's purge to deploy updates instantly. Same policy as
# the legal pages.
/docs/api/*
  Cache-Control: public, max-age=300, s-maxage=86400

# ── PWA: manifest + service worker ──
# Manifest can cache for a day. Service worker MUST never be cached
# beyond the current request — otherwise users keep running the old
# SW after a deploy and never see updates.
/site.webmanifest
  Cache-Control: public, max-age=86400
  Content-Type: application/manifest+json
/sw.js
  Cache-Control: no-cache, no-store, must-revalidate
  Service-Worker-Allowed: /
/offline.html
  Cache-Control: public, max-age=3600

# ── Security headers (apply to everything) ──
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
