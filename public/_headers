# Cloudflare Pages custom headers
# Docs: https://developers.cloudflare.com/pages/platform/headers/

# ── HTML: short cache, re-validate on every visit ──
/
  Cache-Control: public, max-age=0, must-revalidate
/*.html
  Cache-Control: public, max-age=0, must-revalidate

# ── Static assets ──
# Images are nearly immutable → long cache.
/img/*
  Cache-Control: public, max-age=31536000, immutable
# CSS / JS are NOT hashed yet (we bust via ?v= query strings in HTML).
# Short browser cache + long CDN cache: every browser revalidates after
# 5 min, but Cloudflare keeps a fresh copy at the edge for 1 day.
# Cloudflare Pages auto-purges the CDN cache on every deploy, so users
# never see stale JS/CSS for longer than ~5 min after a deploy.
/css/*
  Cache-Control: public, max-age=300, s-maxage=86400
/js/*
  Cache-Control: public, max-age=300, s-maxage=86400

# ── SEO helpers: short cache ──
/robots.txt
  Cache-Control: public, max-age=3600
/sitemap.xml
  Cache-Control: public, max-age=3600

# ── API documentation pages ──
# Docs are static HTML; cache aggressively at the edge but allow
# Cloudflare's purge to deploy updates instantly. Same policy as
# the legal pages.
/docs/api/*
  Cache-Control: public, max-age=300, s-maxage=86400

# ── PWA: manifest + service worker ──
# Manifest can cache for a day. Service worker MUST never be cached
# beyond the current request — otherwise users keep running the old
# SW after a deploy and never see updates.
/site.webmanifest
  Cache-Control: public, max-age=86400
  Content-Type: application/manifest+json
/sw.js
  Cache-Control: no-cache, no-store, must-revalidate
  Service-Worker-Allowed: /
/offline.html
  Cache-Control: public, max-age=3600

# ── Security headers (apply to everything) ──
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; script-src 'self' 'unsafe-eval' https://cdn.jsdelivr.net https://unpkg.com https://giscus.app; style-src 'self' 'unsafe-inline' https://api.fontshare.com https://cdn.jsdelivr.net https://giscus.app; img-src 'self' data: https:; font-src 'self' https://api.fontshare.com https://cdn.fontshare.com https://cdn.jsdelivr.net; connect-src 'self' https://*.convex.cloud https://*.convex.site wss://*.convex.cloud wss://*.convex.site https://giscus.app https://*.giscus.app; frame-src https://giscus.app https://*.giscus.app; worker-src 'self'; manifest-src 'self'; form-action 'self'
