{
  "name": "suprabench",
  "version": "2.0.0",
  "private": true,
  "description": "Community-driven AI model rankings based on benchmark trustworthiness",
  "scripts": {
    "dev": "npx convex dev",
    "deploy": "npx convex deploy",
    "check:tiers": "node scripts/check-tier-consistency.mjs",
    "ranking:lab": "node scripts/ranking-lab.mjs",
    "ranking:pairwise": "node scripts/pairwise-ranking-experiment.mjs",
    "curation:validate": "node scripts/curation-run.mjs validate",
    "curation:dry-run": "node scripts/curation-run.mjs dry-run",
    "curation:apply": "node scripts/curation-run.mjs apply",
    "test": "cd tests/convex && npm test",
    "test:install": "cd tests/convex && npm install"
  },
  "dependencies": {
    "@auth/core": "0.37.0",
    "@convex-dev/auth": "^0.0.91",
    "convex": "^1.41.0"
  },
  "overrides": {
    "ws": "8.21.0"
  }
}
